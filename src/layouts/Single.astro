---
import type { CollectionEntry, DataEntryMap } from 'astro:content';

interface Props {
    entry: CollectionEntry<keyof DataEntryMap>;
}

import BaseLayout from '@/layouts/Base.astro';
import { getCustomComponents } from '@/utils';

import Tags from '@/components/Tags.astro';
import FormattedDate from '@/components/FormattedDate.astro';
import { render } from 'astro:content';

const { entry } = Astro.props;
const { data } = entry as CollectionEntry<"my-thoughts">;
const {
    title,
    description = '',
    date,
    categories,
    featured_image = ''
} = data;
const entryRender = await render(entry);
const { Content } = entryRender;

const layoutProps = {
    title,
    description,
    image: featured_image,
    bodyClass: 'single single--post',
}

const extendedComponents = {
	...getCustomComponents(),
}
---
<BaseLayout {...layoutProps}>
    <article>
        <header class="single__header section">
			<h1 class="single__heading">{title}</h1>
            <div class="single__date">
                <FormattedDate date={date} />
            </div>
			{categories?.length && <div class="single__tags"><Tags tags={categories} /></div>}
		</header>
		<div class="content single__content section">
			<Content components={extendedComponents} />
		</div>
    </article>
</BaseLayout>
