---
import type { CollectionEntry, DataEntryMap } from 'astro:content';

interface Props {
    entry: CollectionEntry<keyof DataEntryMap>;
}

import BaseLayout from '@/layouts/Base.astro';
import FormattedDate from '@/components/FormattedDate.astro';
import Markdown from '@/components/Markdown.astro';
import { render } from 'astro:content';

const { entry } = Astro.props;
const { data } = entry as CollectionEntry<"snippets">;
const {
    title,
    description = '',
    date,
    lastmod,
} = data;
const { Content } = await render(entry);

const layoutProps = {
    title,
    description,
    bodyClass: 'single single--snippet',
}
---
<BaseLayout {...layoutProps}>
    <article>
        <header class="single__header section">
			<h1 class="single__heading">
				<Markdown value={title} />
			</h1>
            <div class="single__date">
                <FormattedDate date={date} />

                {lastmod && lastmod !== date && (
                    <br />
                    <span>(Last modified: <FormattedDate date={lastmod} />)</span>
                )}
            </div>
		</header>
		<div class="content single__content section">
			<Content />
		</div>
    </article>
</BaseLayout>
